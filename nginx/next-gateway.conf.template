server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 25m;

    # Laravel APIs and authentication stay on the same public origin as Next.
    location ^~ /api/ { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location ^~ /sanctum/ { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location ^~ /auth/ { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location = /login { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location = /register { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location = /logout { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location = /up { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }
    location ^~ /storage/ { proxy_pass http://laravel.test:80; include /etc/nginx/proxy_params; }

    location ^~ /_next/ {
        proxy_pass http://next:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ^~ /images/ { proxy_pass http://next:3000; include /etc/nginx/proxy_params; }

    # Next.js owns every user-facing page.
    location / { proxy_pass http://next:3000; include /etc/nginx/proxy_params; }
}
