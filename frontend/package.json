{
    "name": "plagine-frontend",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
