        "axios": "^1.12.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.544.0",
        "next": "^16.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.63.0",
        "tailwind-merge": "^3.3.1",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.1.14",
